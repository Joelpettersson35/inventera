generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String          @id @default(uuid())
  name     String          @unique
  articles Article[]
  fields   CategoryField[]
}

model Article {
  id          String   @id @default(uuid())
  name        String
  quantity    Int      @default(0)
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id]) //fields är denna modellens fält som ska kopplas till references vilket är den främmande modellens fält (id)

  attributes Json @default("{}")

  @@index([categoryId])
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
}

model CategoryField {
  id       String    @id @default(uuid())
  label    String
  type     FieldType
  required Boolean   @default(false)
  position Int       @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}
