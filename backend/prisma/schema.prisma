generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String          @id @default(uuid())
  name     String          @unique
  articles Article[]
  fields   CategoryField[]
}

model Article {
  id          String       @id @default(uuid())
  name        String
  quantity    Int          @default(0)
  description String       @default("")
  placements  BoxArticle[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id]) //fields är denna modellens fält som ska kopplas till references vilket är den främmande modellens fält (id)

  attributes Json @default("{}")

  @@index([categoryId])
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
}

model CategoryField {
  id       String    @id @default(uuid())
  label    String
  type     FieldType
  required Boolean   @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Shelf {
  id    String @id @default(uuid())
  name  String @unique
  boxes Box[]
}

model Box {
  id   String @id @default(uuid())
  name String

  shelfId String
  shelf   Shelf  @relation(fields: [shelfId], references: [id], onDelete: Restrict)

  articles BoxArticle[]

  @@unique([shelfId, name])
}

model BoxArticle {
  boxId     String
  articleId String
  quantity  Int    @default(0)

  box     Box     @relation(fields: [boxId], references: [id], onDelete: Restrict)
  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@id([boxId, articleId])
  @@index([articleId])
}
